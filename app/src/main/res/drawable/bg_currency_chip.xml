<?xml version="1.0" encoding="utf-8"?>
<!-- M3 assist-chip look drawn over the primary-colored header: full-round, tonal fill,
     outline-variant stroke. Colors are translucent so they work over any primary color. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#73FFFFFF" />
        </shape>
    </item>
</ripple>
