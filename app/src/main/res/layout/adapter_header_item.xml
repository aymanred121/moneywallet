<!-- Material 3 list section header: label-large on a surface-container tonal band. -->
<com.oriondev.moneywallet.ui.view.theme.ThemedFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/material_component_lists_header_height"
    android:foreground="?attr/selectableItemBackground"
    app:theme_backgroundColor="colorSurfaceContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/material_component_lists_header_start_margin"
        android:paddingStart="@dimen/material_component_lists_header_start_margin"
        android:paddingRight="@dimen/material_component_lists_header_end_margin"
        android:paddingEnd="@dimen/material_component_lists_header_end_margin">

        <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
            android:id="@+id/left_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.MoneyWallet.LabelLarge"
            android:textSize="@dimen/material_component_lists_header_text_size"
            android:maxLines="1"
            android:ellipsize="end"
            app:theme_textColor="textColorSecondary"
            tools:text="This is the left text" />

        <TextView
            android:id="@+id/right_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            android:textAppearance="@style/TextAppearance.MoneyWallet.LabelLarge"
            android:textSize="@dimen/material_component_lists_header_text_size"
            android:maxLines="1"
            tools:text="This is the right text" />

    </LinearLayout>

</com.oriondev.moneywallet.ui.view.theme.ThemedFrameLayout>
