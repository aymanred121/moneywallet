<!-- Material 3 two-line list item with leading avatar (40dp) and trailing amount. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/material_component_lists_two_line_with_avatar_height"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/avatar_image_view"
        android:layout_width="@dimen/material_component_lists_two_line_avatar_width"
        android:layout_height="@dimen/material_component_lists_two_line_avatar_height"
        android:layout_marginLeft="@dimen/material_component_lists_two_line_avatar_start_margin"
        android:layout_marginStart="@dimen/material_component_lists_two_line_avatar_start_margin"
        android:scaleType="centerCrop"
        android:contentDescription="@string/description_transaction_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_launcher" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/text_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Headline: title-medium -->
    <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
        android:id="@+id/primary_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/material_component_lists_two_line_primary_text_start_margin"
        android:layout_marginStart="@dimen/material_component_lists_two_line_primary_text_start_margin"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        android:textAppearance="@style/TextAppearance.MoneyWallet.TitleMedium"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintBottom_toTopOf="@+id/text_guideline"
        app:layout_constraintEnd_toStartOf="@+id/money_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:theme_textColor="textColorPrimary"
        tools:text="This is the primary text" />

    <!-- Trailing amount: label-large, colored income/expense by MoneyFormatter -->
    <TextView
        android:id="@+id/money_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/material_component_lists_two_line_primary_text_end_margin"
        android:layout_marginEnd="@dimen/material_component_lists_two_line_primary_text_end_margin"
        android:layout_marginBottom="2dp"
        android:textAppearance="@style/TextAppearance.MoneyWallet.LabelLarge"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/text_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="€ 500.00" />

    <!-- Supporting text: body-medium, shrinks and ellipsizes to leave room for the date -->
    <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
        android:id="@+id/secondary_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/material_component_lists_two_line_primary_text_start_margin"
        android:layout_marginStart="@dimen/material_component_lists_two_line_primary_text_start_margin"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.MoneyWallet.BodyMedium"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@+id/text_guideline"
        app:layout_constraintEnd_toStartOf="@+id/date_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:theme_textColor="textColorSecondary"
        tools:text="This is the secondary text" />

    <!-- Trailing supporting text: original-currency amount + date, e.g. "SAR 150.00 • Sep 10".
         End-aligned, may take up to ~60% of the row before it ellipsizes. -->
    <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
        android:id="@+id/date_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/material_component_lists_two_line_primary_text_end_margin"
        android:layout_marginEnd="@dimen/material_component_lists_two_line_primary_text_end_margin"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.MoneyWallet.BodyMedium"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@+id/text_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="0.6"
        app:theme_textColor="textColorSecondary"
        tools:text="SAR 150.00 • Sep 10" />

</androidx.constraintlayout.widget.ConstraintLayout>
